import os
import time
import sqlite3
import logging
from fastapi import FastAPI, HTTPException, Header
from pydantic import BaseModel
from dotenv import load_dotenv

# تحميل متغيرات البيئة من ملف التكوين[span_2](start_span)[span_2](end_span)
load_dotenv()

# إعداد سجلات التتبع (Logging) بناءً على مستوى السجلات المحدد[span_3](start_span)[span_3](end_span)
log_level = os.getenv("LOG_LEVEL", "INFO")
logging.basicConfig(level=getattr(logging, log_level.upper(), logging.INFO))
logger = logging.getLogger("AI-QUANT-X")

# قراءة الإعدادات والمتغيرات من المصدر[span_4](start_span)[span_4](end_span)
HOST = os.getenv("HOST", "0.0.0.0")
PORT = int(os.getenv("PORT", 8080))
DB_PATH = os.getenv("DB_PATH", "/data/ai_quant_x.db")
INITIAL_BALANCE = float(os.getenv("INITIAL_BALANCE", 200))

SCAN_INTERVAL_SECONDS = int(os.getenv("SCAN_INTERVAL_SECONDS", 180))
POSITION_CHECK_SECONDS = int(os.getenv("POSITION_CHECK_SECONDS", 15))
MIN_24H_VOLUME_USDT = float(os.getenv("MIN_24H_VOLUME_USDT", 5000000))
STRATEGIES = os.getenv("STRATEGIES", "trend,mean_reversion,breakout,dip_buyer").split(",")
USE_SYMBOL_SCANNER = os.getenv("USE_SYMBOL_SCANNER", "true").lower() == "true"

# إعدادات المخاطر[span_5](start_span)[span_5](end_span)
RISK_PER_TRADE_PCT = float(os.getenv("RISK_PER_TRADE_PCT", 2.0))
MAX_PORTFOLIO_RISK_PCT = float(os.getenv("MAX_PORTFOLIO_RISK_PCT", 10.0))
MAX_SAME_SIDE = int(os.getenv("MAX_SAME_SIDE", 3))
DAILY_LOSS_LIMIT_PCT = float(os.getenv("DAILY_LOSS_LIMIT_PCT", 3.0))
FUTURES_LEVERAGE = int(os.getenv("FUTURES_LEVERAGE", 1))

# التحكم في الوصول لوحة القيادة[span_6](start_span)[span_6](end_span)
DASHBOARD_KEY = os.getenv("DASHBOARD_KEY", "")
ALLOW_INSECURE_DASHBOARD = os.getenv("ALLOW_INSECURE_DASHBOARD", "false").lower() == "true"

# التحقق من سقف المخاطر الإجمالية (يجب ألا يتجاوز 10%)[span_7](start_span)[span_7](end_span)
if MAX_PORTFOLIO_RISK_PCT > 10.0:
    raise ValueError("MAX_PORTFOLIO_RISK_PCT cannot exceed 10% at startup.")

app = FastAPI(title="AI QUANT X 7.1.0", version="7.1.0")

def init_db():
    """تهيئة قاعدة البيانات SQLite في المسار المحدد[span_8](start_span)[span_8](end_span)"""
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS portfolio (
            balance REAL,
            equity REAL,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS trades (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            symbol TEXT,
            strategy TEXT,
            side TEXT,
            entry_price REAL,
            size REAL,
            status TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    
    # إدخال الرصيد الافتراضي إذا لم يكن موجوداً[span_9](start_span)[span_9](end_span)
    cursor.execute("SELECT COUNT(*) FROM portfolio")
    if cursor.fetchone()[0] == 0:
        cursor.execute("INSERT INTO portfolio (balance, equity) VALUES (?, ?)", (INITIAL_BALANCE, INITIAL_BALANCE))
        conn.commit()
    conn.close()

@app.on_event("startup")
def startup_event():
    logger.info(f"Starting AI QUANT X 7.1.0 engine on {HOST}:{PORT}[span_10](start_span)[span_10](end_span)...")
    logger.info(f"Configured Strategies: {STRATEGIES}[span_11](start_span)[span_11](end_span)")
    logger.info(f"Risk per trade: {RISK_PER_TRADE_PCT}%, Max Portfolio Risk: {MAX_PORTFOLIO_RISK_PCT}%[span_12](start_span)[span_12](end_span)")
    init_db()

@app.get("/")
def read_root():
    return {
        "system": "AI QUANT X 7.1.0",
        "mode": "PAPER TRADING ONLY",
        "strategies": STRATEGIES,
        "initial_balance": INITIAL_BALANCE,
        "futures_leverage": FUTURES_LEVERAGE
    }

@app.post("/control/execute")
def execute_control(dashboard_key: str = Header(None)):
    """التحكم في لوحة القيادة مع التحقق من المفتاح[span_13](start_span)[span_13](end_span)"""
    if not DASHBOARD_KEY and not ALLOW_INSECURE_DASHBOARD:
        raise HTTPException(status_code=403, detail="Dashboard is read-only. DASHBOARD_KEY is missing and insecure mode is disabled[span_14](start_span)[span_14](end_span).")
    if DASHBOARD_KEY and dashboard_key != DASHBOARD_KEY:
        raise HTTPException(status_code=401, detail="Invalid Dashboard Key.")
    
    return {"status": "success", "message": "Command executed successfully in paper trading mode[span_15](start_span)[span_15](end_span)."}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host=HOST, port=PORT)
