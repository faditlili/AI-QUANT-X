# ===== AI QUANT X 7.1.0 - PAPER TRADING ONLY. No exchange API keys are ever needed or read. =====
HOST=0.0.0.0
PORT=8080
# MUST live on a Railway Volume mounted at /data, otherwise the history is lost on every redeploy.
DB_PATH=/data/ai_quant_x.db
INITIAL_BALANCE=200

# --- scanning / data ---
SCAN_INTERVAL_SECONDS=180
POSITION_CHECK_SECONDS=15
MIN_24H_VOLUME_USDT=5000000
STRATEGIES=trend,mean_reversion,breakout,dip_buyer
# SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
USE_SYMBOL_SCANNER=true
DATA_STALE_SECONDS=300
PRICE_MAX_AGE_SECONDS=30

# --- risk (aggregate open risk is capped at 10% of CURRENT equity; values above 10 are rejected at startup) ---
RISK_PER_TRADE_PCT=2.0
MAX_PORTFOLIO_RISK_PCT=10.0
MAX_SAME_SIDE=3
DAILY_LOSS_LIMIT_PCT=3.0
# Futures simulation: isolated margin. 1 = no leverage (default).
FUTURES_LEVERAGE=1
FUNDING_ENABLED=true
REQUIRE_SYMBOL_RULES=true

# --- features ---
TRAILING_ENABLED=true
SCALE_OUT_ENABLED=true
USE_ML_FILTER=true
NEWS_ENABLED=false
BACKTEST_CANDLES=2000
LOG_LEVEL=INFO

# --- access control ---
# REQUIRED in production: protects the dashboard and its control buttons.
# With an empty key every control POST is refused (read-only dashboard) unless ALLOW_INSECURE_DASHBOARD=true.
DASHBOARD_KEY=
ALLOW_INSECURE_DASHBOARD=false

# --- Telegram (optional; the engine runs fine without it) ---
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_CHAT_ID=
