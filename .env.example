# AI QUANT X - environment template. PAPER SIMULATION ONLY: no exchange keys are used or needed.

# --- Secrets (leave empty here; never commit real values) ---
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_CHAT_ID=
DASHBOARD_KEY=
ALLOW_INSECURE_DASHBOARD=false

# --- Server ---
HOST=0.0.0.0
PORT=8080
DB_PATH=/data/ai_quant_x.db
LOG_LEVEL=INFO

# --- Account / risk (portfolio risk cap must stay <= 10) ---
INITIAL_BALANCE=200
RISK_PER_TRADE_PCT=2.0
MAX_PORTFOLIO_RISK_PCT=10.0
MAX_TOTAL_HEAT_PCT=10.0
MAX_DIRECTIONAL_HEAT_PCT=10.0
MAX_SAME_SIDE=3
MAX_ALLOCATION_PCT=100.0
DAILY_LOSS_LIMIT_PCT=3.0
FUTURES_LEVERAGE=1
MAINTENANCE_MARGIN_RATE=0.005
PAIR_LOCK_AFTER_STOPLOSS_MIN=120
STRATEGY_PAUSE_SECONDS=21600
CORRELATION_MAX=0.85

# --- Scanning / data ---
STRATEGIES=trend,mean_reversion,breakout,dip_buyer
USE_SYMBOL_SCANNER=true
MAX_SYMBOLS_TO_SCAN=50
MIN_24H_VOLUME_USDT=5000000
SCAN_INTERVAL_SECONDS=180
MAX_SCAN_DURATION_SECONDS=150
POSITION_CHECK_SECONDS=15
KLINE_CACHE_SECONDS=20
PRICE_MAX_AGE_SECONDS=30
DATA_STALE_SECONDS=300
SYMBOL_INFO_TTL_SECONDS=21600
SYMBOL_SCAN_REFRESH_SECONDS=43200
REQUIRE_SYMBOL_RULES=true
# SYMBOLS=BTCUSDT,ETHUSDT,...
# BINANCE_WS_URL=

# --- Filters / behaviour ---
USE_BTC_COMPASS=true
USE_FUNDING_RATE_FILTER=true
USE_ROLLING_VWAP=true
USE_SESSION_FILTER=false
STRICT_HTF_CONFIRM=false
FUNDING_ENABLED=true
SCALE_OUT_ENABLED=true
TRAILING_ENABLED=true
TRUSTED_PROXY=true
ENTRY_MAX_DRIFT_ATR=1.0
CONFLICT_MIN_SCORE_GAP=15
NEWS_ENABLED=false

# --- ML filter ---
USE_ML_FILTER=true
ML_HORIZON_CANDLES=4
ML_MIN_ACCURACY=0.52
ML_RETRAIN_DAYS=7
BRAIN_MIN_TRADES=30
# ML_MODEL_PATH=
# ML_TRAIN_SYMBOLS=

# --- Backtest / auto-tune ---
BACKTEST_CANDLES=2000
AUTOTUNE_MIN_TRADES=8
AUTOTUNE_MIN_PROFIT_FACTOR=1.1
AUTOTUNE_MAX_DRAWDOWN_PCT=25
AUTOTUNE_TEST_FRACTION=0.3
AUTOTUNE_TEST_MIN_TRADES=10
AUTOTUNE_TEST_MIN_PROFIT_FACTOR=1.2

# --- New engines: every flag is OFF by default (Legacy Core unchanged) ---
FF_ADVANCED_DATA=false
FF_LIGHTGBM=false
FF_META_LABELING=false
FF_ORDER_FLOW=false
FF_MARKET_REGIME=false
FF_ADVANCED_BACKTEST=false
# EDGE_DB_PATH=
# EDGE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# EDGE_INTERVAL_SECONDS=300
# EDGE_LIQUIDATIONS=true

ENABLE_LEGACY_DASHBOARD=false
